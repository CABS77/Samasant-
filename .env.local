# Configuration locale de développement pour Samasanté
# Ce fichier n'est pas versionné et contient les variables d'environnement locales

# Désactive les avertissements de compilation non critiques
NEXT_WEBPACK_USEPOLLING=false
NEXT_TELEMETRY_DISABLED=1

# Optimisation des performances de développement
FAST_REFRESH=true

# Configuration pour Genkit AI (si nécessaire)
NODE_OPTIONS="--max_old_space_size=4096"

# Mode de développement
NODE_ENV=development
