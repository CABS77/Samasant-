# ============================================
# EXEMPLE DE CONFIGURATION - SamaSanté AI
# ============================================
# Copiez ce fichier vers .env.local et remplissez avec vos vraies clés

# ============================================
# CONFIGURATION IA - CLAUDE (fournisseur principal)
# ============================================
# Dès que ANTHROPIC_API_KEY est définie, l'IA passe sur Claude.
# Sans elle, l'app reste sur DeepSeek (ci-dessous).
# Clé API : https://platform.claude.com/
ANTHROPIC_API_KEY=
# Modèle Claude (par défaut claude-sonnet-5-5 ; claude-haiku-4-5-20251001 pour réduire le coût)
CLAUDE_MODEL=claude-sonnet-5-5
# Tokens max par réponse (plafond serveur 2048, conversation initiale 800)
# CLAUDE_MAX_TOKENS=2048
# Forcer un fournisseur : claude ou deepseek (optionnel)
# AI_PROVIDER=

# ============================================
# CONFIGURATION IA - DEEPSEEK (repli)
# ============================================
# Obtenez votre clé API sur : https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# chat = deepseek-flash ; reasoner = deepseek-v4-pro. Vérifier les tarifs chez le fournisseur.
DEEPSEEK_MODEL=chat

# ============================================
# CONFIGURATION SUPABASE (REQUIS)
# ============================================
# Obtenez vos clés sur : https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Secret serveur uniquement : ne jamais utiliser un préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Appliquer toutes les migrations supabase/migrations/*.sql dans l’ordre.

# Administration : aucun mot de passe par défaut.
# ADMIN_PASSWORD : démonstration locale sans base ; ignoré en production.
# Avec Supabase configuré, les mutations exigent une session individuelle MFA.
# Production : comptes Supabase individuels autorisés, avec MFA TOTP.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_USER_IDS=
# Secret HMAC >=32 caractères ; ADMIN_SESSION_SECRET utilisé si absent.
AI_QUOTA_SECRET=
AI_DAILY_BUDGET_REQUESTS=1000

# ============================================
# CONFIGURATION MAPBOX (OPTIONNEL)
# ============================================
# Pour la géolocalisation des cliniques
# Obtenez votre token sur : https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ4eHh4eHh4In0.xxxxx

# ============================================
# CONFIGURATION TWILIO SMS (OPTIONNEL)
# ============================================
# Pour les alertes d'urgence par SMS
# Obtenez vos credentials sur : https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+221xxxxxxxxx
# Répertoire serveur des cliniques partenaires ayant accepté de recevoir les alertes.
# Tableau JSON : id, name, phoneNumber (E.164), latitude, longitude.
# Sans partenaires configurés : aucun SMS d'urgence et aucun succès annoncé.
EMERGENCY_CLINICS_JSON=[]
TWILIO_STATUS_CALLBACK_URL=https://www.samasante.tech/api/notifications/twilio
# Clé AES-GCM : 32 octets aléatoires encodés en 64 caractères hexadécimaux.
SMS_OUTBOX_KEY=
# Secret >=32 caractères pour le cron Vercel. Durée à choisir explicitement (30..365 jours).
CRON_SECRET=
APPOINTMENT_RETENTION_DAYS=

# ============================================
# OPTIMISATIONS NEXT.JS
# ============================================
NEXT_WEBPACK_USEPOLLING=false
NEXT_TELEMETRY_DISABLED=1
FAST_REFRESH=true
NODE_OPTIONS="--max_old_space_size=4096"
NODE_ENV=development
