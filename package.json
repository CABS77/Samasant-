{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts --ext .ts,.tsx,.js,.cjs",
    "lint:fix": "eslint src tests scripts --ext .ts,.tsx,.js,.cjs --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky install",
    "verify:db": "node scripts/verify-appointment-schema.cjs",
    "verify:browser": "node scripts/verify-browser.cjs"
  },
  "dependencies": {
