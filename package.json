    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    },
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/propagator-jaeger": "2.12.0",
    "@opentelemetry/auto-instrumentations-node": {
      ".": "0.81.0",
